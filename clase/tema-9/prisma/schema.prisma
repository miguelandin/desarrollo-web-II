// Prisma Schema - Ejemplo T9
// Documentación: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum Role {
    USER
    ADMIN
    LIBRARIAN
}

enum Genre {
    Comedia
    Tragedia
    Romance
    Drama
    Suspense
    Aventura
}

enum Status {
    ACTIVE
    RETURNED
    OVERDUE
}

// ==================== MODELS ====================

// Modelo de Usuario
model User {
    id        Int      @id @default(autoincrement())
    email     String   @unique
    name      String
    password  String
    role      Role     @default(USER)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relaciones
    loans   Loan[]
    reviews Review[]

    @@map("users")
}

model Book {
    id            Int      @id @default(autoincrement())
    isbn          String   @unique
    title         String
    author        String
    genre         Genre
    description   String?
    publishedYear Int
    copies        Int
    available     Int

    loans   Loan[]
    reviews Review[]

    @@map("books")
}

model Loan {
    id         Int       @id @default(autoincrement())
    userId     Int
    bookId     Int
    loanDate   DateTime  @default(now())
    dueDate    DateTime
    returnDate DateTime?
    status     Status    @default(ACTIVE)

    book Book @relation(fields: [bookId], references: [id])
    user User @relation(fields: [userId], references: [id])

    @@map("loans")
}

// Modelo de Comentario
model Review {
    id        Int      @id @default(autoincrement())
    userId    Int
    bookId    Int
    rating    Int // de 1 a 5
    comment   String?
    createdAt DateTime @default(now())
    user      User     @relation(fields: [userId], references: [id])
    book      Book     @relation(fields: [bookId], references: [id])

    @@unique([userId, bookId])
    @@map("reviews")
}
